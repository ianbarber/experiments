@@ -308,6 +308,62 @@ static void createBarrierExpect(TritonOpBuilder &self,
 
 // Named barrier ops are now handled by runtime op wrappers in ops/NewOps.cpp
 
+// The verifier requires the !tt.tensordesc block type to carry the same
+// shared encoding as the SMEM buffer (it also drives the tensormap swizzle).
+// Plain tl.make_tensor_descriptor leaves sharedLayout null, so stamp the
+// buffer's encoding onto the descriptor's type (Gluon descs are born encoded).
+static void alignDescLayoutToMem(mlir::Value desc, mlir::Value mem) {
+  auto descTy = llvm::dyn_cast<mlir::triton::TensorDescType>(desc.getType());
+  auto memTy = llvm::dyn_cast<ttg::MemDescType>(mem.getType());
+  if (!descTy || !memTy || !memTy.getEncoding() || descTy.getSharedLayout())
+    return;
+  desc.setType(mlir::triton::TensorDescType::get(
+      descTy.getShape(), descTy.getElementType(), memTy.getEncoding()));
+}
+
+// --- utlx_async_TMA_load: upstream ttng.async_tma_copy_global_to_local ---
+// operands: [result slot, desc, barrier, result memdesc, pred, coord...]
+static void createAsyncTMALoadUpstream(TritonOpBuilder &self,
+                                       std::vector<mlir::Value> &operands) {
+  if (operands.size() < 6)
+    return;
+  mlir::Value desc = operands[1];
+  mlir::Value barrier = operands[2];
+  mlir::Value result = operands[3];
+  mlir::Value pred = operands[4];
+  alignDescLayoutToMem(desc, result);
+  llvm::SmallVector<mlir::Value> coord(operands.begin() + 5, operands.end());
+  self.create<ttng::AsyncTMACopyGlobalToLocalOp>(
+      desc, coord, mlir::ValueRange{}, barrier, result, pred,
+      /*multicast=*/false);
+}
+
+// --- utlx_async_TMA_store: upstream ttng.async_tma_copy_local_to_global ---
+// operands: [result slot, desc, src memdesc, coord...]
+static void createAsyncTMAStoreUpstream(TritonOpBuilder &self,
+                                        std::vector<mlir::Value> &operands) {
+  if (operands.size() < 4)
+    return;
+  mlir::Value desc = operands[1];
+  mlir::Value src = operands[2];
+  alignDescLayoutToMem(desc, src);
+  llvm::SmallVector<mlir::Value> coord(operands.begin() + 3, operands.end());
+  self.create<ttng::AsyncTMACopyLocalToGlobalOp>(desc, coord, src);
+}
+
+// --- utlx_async_TMA_store_wait: upstream ttng.async_tma_store_wait ---
+// operands: [result slot, pendings (const i32)]
+static void createAsyncTMAStoreWaitUpstream(
+    TritonOpBuilder &self, std::vector<mlir::Value> &operands) {
+  if (operands.size() < 2)
+    return;
+  auto pendings = extractConstantInt(operands[1]);
+  if (!pendings)
+    return;
+  self.create<ttng::TMAStoreWaitOp>(static_cast<int>(*pendings),
+                                    /*readOnly=*/false);
+}
