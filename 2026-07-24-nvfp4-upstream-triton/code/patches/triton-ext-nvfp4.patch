+// --- utlx_set_ws_requested_regs: re-stamp explicit requestedRegisters on
+// ttg.warp_specialize AFTER upstream's OptimizePartitionWarps clobbers them
+// with its hardcoded estimates (estRegs = tensorRegs ? 88 : 24). Run at the
+// end of make_ttgir so AllocateWarpGroups sees the kernel's true requests.
+namespace {
+struct SetWSRequestedRegs
+    : public mlir::PassWrapper<SetWSRequestedRegs,
+                               mlir::OperationPass<mlir::ModuleOp>> {
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(SetWSRequestedRegs)
+  llvm::SmallVector<int32_t> regs;
+  SetWSRequestedRegs() = default;
+  SetWSRequestedRegs(const SetWSRequestedRegs &o)
+      : mlir::PassWrapper<SetWSRequestedRegs,
+                          mlir::OperationPass<mlir::ModuleOp>>(o),
+        regs(o.regs) {}
+  explicit SetWSRequestedRegs(llvm::ArrayRef<int32_t> r)
+      : regs(r.begin(), r.end()) {}
+  llvm::StringRef getArgument() const override {
+    return "utlx-set-ws-requested-regs";
+  }
+  llvm::StringRef getDescription() const override {
+    return "restore explicit warp_specialize requestedRegisters";
+  }
+  void runOnOperation() override {
+    getOperation().walk([&](mlir::triton::gpu::WarpSpecializeOp op) {
+      if (regs.size() == op.getPartitionNumWarps().size())
+        op.setRequestedRegisters(regs);
+      else
+        llvm::errs() << "utlx_set_ws_requested_regs: arg count "
+                     << regs.size() << " != partitions "
+                     << op.getPartitionNumWarps().size() << ", skipping\n";
+    });
+  }
+};
+} // namespace
+
+static void addSetWSRequestedRegsPass(mlir::PassManager *pm,
+                                      const std::vector<std::string> &args) {
+  llvm::SmallVector<int32_t> regs;
+  for (const auto &a : args)
+    regs.push_back(std::atoi(a.c_str()));
+  pm->addPass(std::make_unique<SetWSRequestedRegs>(regs));
+}
