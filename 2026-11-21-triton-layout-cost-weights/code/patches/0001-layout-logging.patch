+  o["subject"] = describeConvertOp(convertOp);
+  o["convert_cost"] = convertLayoutCost;
+  o["remat_cost"] = rematerialisationCost;
+  o["new_cvt_cost"] = newCvtCost;
+  o["new_conversions"] = std::move(layoutlog::pendingNewConversions());
+  layoutlog::pendingNewConversions() = llvm::json::Array();
+  o["slice_values"] = (int64_t)sliceValues;
+  o["slice_ops"] = (int64_t)sliceOps;
+  o["outside_values"] = (int64_t)outsideValues;
+  o["disable_remat_splitting"] = disableRematSplitting;
+  o["outcome"] = outcome;
+  o["reason"] = reason;
+  layoutlog::emit(std::move(o));
+}
