diff --git a/include/triton/Analysis/LayoutLog.h b/include/triton/Analysis/LayoutLog.h
new file mode 100644
index 000000000..73e793e0f
--- /dev/null
+++ b/include/triton/Analysis/LayoutLog.h
@@ -0,0 +1,57 @@
+#ifndef TRITON_ANALYSIS_LAYOUTLOG_H
+#define TRITON_ANALYSIS_LAYOUTLOG_H
+
+// Experiment instrumentation for RemoveLayoutConversions. Nothing in here may
+// change what the compiler decides: every function only reads IR and appends
+// JSON lines to the file named by TRITON_LAYOUT_LOG.
+
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/BuiltinTypes.h"
+#include "llvm/Support/JSON.h"
+#include <string>
+
+namespace mlir::triton::layoutlog {
+
+// True when TRITON_LAYOUT_LOG names a file.
+bool enabled();
+
+// Called once at the start of every RemoveLayoutConversions run. Returns the
+// 1-based index of the run within the current compilation. A compilation is
+// identified by the value of TRITON_LAYOUT_TAG, which the driver must change
+// for every compile.
+int beginInvocation();
+int currentInvocation();
+
+// Counters that restart at every pass invocation.
+int nextConflictIndex();
+int nextDecisionIndex();
+
+// Phase label attached to subsequent events ("forward", "backward_remat",
+// "hoist_ext", ...).
+void setPhase(const char *phase);
+
+// Conversions created by a hoist that is about to be costed. Filled by the
+// caller, consumed by the next remat_decision event.
+llvm::json::Array &pendingNewConversions();
+
+// Append one event. Adds "tag", "inv", "phase" and "seq".
+void emit(llvm::json::Object &&event);
+
+std::string str(Attribute attr);
+std::string str(Type type);
+std::string funcName(Operation *op);
+unsigned loopDepth(Operation *op);
+
+// Describe the conversion srcTy -> srcTy.cloneWithEncoding(dstEncoding) the
+// way ConvertLayoutOpToLLVM dispatches it: class, barrier kind, bytes, and the
+// price getConvertCost assigns.
+llvm::json::Object describeConversion(RankedTensorType srcTy,
+                                      Attribute dstEncoding,
+                                      bool forceWarpShuffle = false);
+
+// One "census" event per ttg.convert_layout in the module.
+void census(ModuleOp module, llvm::StringRef stage);
+
+} // namespace mlir::triton::layoutlog
+
+#endif // TRITON_ANALYSIS_LAYOUTLOG_H
