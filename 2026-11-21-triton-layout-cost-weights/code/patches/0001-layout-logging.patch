diff --git a/lib/Analysis/LayoutLog.cpp b/lib/Analysis/LayoutLog.cpp
new file mode 100644
index 000000000..94d9ec34c
--- /dev/null
+++ b/lib/Analysis/LayoutLog.cpp
@@ -0,0 +1,236 @@
+#include "triton/Analysis/LayoutLog.h"
+
+#include "mlir/Dialect/SCF/IR/SCF.h"
+#include "triton/Analysis/Utility.h"
+#include "triton/Dialect/Triton/IR/Dialect.h"
+#include "triton/Dialect/Triton/IR/Utility.h"
+#include "triton/Dialect/TritonGPU/IR/Dialect.h"
+#include "triton/Dialect/TritonGPU/IR/LinearLayoutConversions.h"
+#include "triton/Tools/LayoutUtils.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+
+namespace mlir::triton::layoutlog {
+
+namespace {
+std::mutex gMutex;
+std::string gLastTag;
+bool gHaveTag = false;
+int gInvocation = 0;
+int gConflict = 0;
+int gDecision = 0;
+int64_t gSeq = 0;
+const char *gPhase = "";
+llvm::json::Array gPendingNewConversions;
+
+const char *logPath() {
+  const char *path = std::getenv("TRITON_LAYOUT_LOG");
+  return (path && *path) ? path : nullptr;
+}
+
+std::string currentTag() {
+  const char *tag = std::getenv("TRITON_LAYOUT_TAG");
+  return tag ? std::string(tag) : std::string();
+}
+} // namespace
+
+bool enabled() { return logPath() != nullptr; }
+
+int beginInvocation() {
+  std::lock_guard<std::mutex> lock(gMutex);
+  std::string tag = currentTag();
+  if (!gHaveTag || tag != gLastTag) {
+    gLastTag = tag;
+    gHaveTag = true;
+    gInvocation = 0;
+  }
+  gConflict = 0;
+  gDecision = 0;
+  gPendingNewConversions.clear();
+  return ++gInvocation;
+}
+
+int currentInvocation() { return gInvocation; }
+int nextConflictIndex() { return gConflict++; }
+int nextDecisionIndex() { return gDecision++; }
+void setPhase(const char *phase) { gPhase = phase; }
+llvm::json::Array &pendingNewConversions() { return gPendingNewConversions; }
+
+void emit(llvm::json::Object &&event) {
+  const char *path = logPath();
+  if (!path)
+    return;
+  std::lock_guard<std::mutex> lock(gMutex);
+  event["tag"] = currentTag();
+  event["inv"] = gInvocation;
+  event["phase"] = gPhase;
+  event["seq"] = gSeq++;
+  std::string line;
+  llvm::raw_string_ostream os(line);
+  os << llvm::json::Value(std::move(event)) << "\n";
+  os.flush();
+  if (FILE *f = std::fopen(path, "a")) {
+    std::fwrite(line.data(), 1, line.size(), f);
+    std::fclose(f);
+  }
+}
+
+std::string str(Attribute attr) {
+  std::string s;
+  llvm::raw_string_ostream os(s);
+  if (attr)
+    attr.print(os);
+  else
+    os << "<null>";
+  return s;
+}
+
+std::string str(Type type) {
+  std::string s;
+  llvm::raw_string_ostream os(s);
+  type.print(os);
+  return s;
+}
+
+std::string funcName(Operation *op) {
+  for (Operation *p = op; p; p = p->getParentOp())
+    if (auto func = dyn_cast<triton::FuncOp>(p))
+      return func.getName().str();
+  return "";
+}
+
+unsigned loopDepth(Operation *op) {
+  unsigned depth = 0;
+  if (!op)
+    return depth;
+  for (Operation *p = op->getParentOp(); p; p = p->getParentOp())
+    if (isa<scf::ForOp, scf::WhileOp>(p))
+      ++depth;
+  return depth;
+}
+
+llvm::json::Object describeConversion(RankedTensorType srcTy,
+                                      Attribute dstEncoding,
+                                      bool forceWarpShuffle) {
+  using namespace mlir::triton::gpu;
+  llvm::json::Object o;
+  MLIRContext *ctx = srcTy.getContext();
+  RankedTensorType dstTy = srcTy.cloneWithEncoding(dstEncoding);
+  auto kReg = StringAttr::get(ctx, "register");
+  auto kWarp = StringAttr::get(ctx, "warp");
+  auto kBlock = StringAttr::get(ctx, "block");
+
+  // Size, and the size getConvertCost charges for.
+  int64_t elems = srcTy.getNumElements();
+  Type elemTy = srcTy.getElementType();
+  int64_t bits = getIntOrFloatOrPtrBitWidth(elemTy);
+  int64_t pricedBits = isa<PointerType>(elemTy) ? 0 : bits;
+  int64_t pricedBytes =
+      (std::max<int64_t>(elems, 32) * std::max<int64_t>(pricedBits, 32)) >> 3;
+  bool pricedFree = cvtReordersRegisters(srcTy, dstTy);
+
+  // The dispatch in ConvertLayoutOpConversion::matchAndRewrite.
+  LinearLayout rawSrc = toLinearLayout(srcTy);
+  LinearLayout rawDst = toLinearLayout(dstTy);
+  LinearLayout srcLayout = rawSrc.removeZeroBasesAlongDim(kReg);
+  LinearLayout dstLayout = rawDst.removeZeroBasesAlongDim(kReg);
+  LinearLayout conversion = minimalCvtLayout(srcLayout, dstLayout);
+  int numDims = conversion.getNumInDims();
+
+  const char *cls = "";
+  const char *barrier = "none";
+  bool canShuffle = false;
+  int numMixed = -1;
+  bool classifierMismatch = false;
+  if (numDims == 0) {
+    cls = "noop";
+  } else if (numDims == 1) {
+    cls = "register_permute";
+  } else {
+    // Same test as the file-static cvtNeedsWarpShuffle in Analysis/Utility.cpp.
+    canShuffle = isPermutationMatrixLayout(srcLayout) &&
+                 isPermutationMatrixLayout(dstLayout);
+    if (canShuffle) {
+      auto local = invertAndComposeLocal(srcLayout, dstLayout, {kWarp, kBlock});
+      canShuffle = local.isIdentityOnOutDim(kWarp) &&
+                   local.isIdentityOnOutDim(kBlock) &&
+                   local.sublayoutIsZero({kWarp, kBlock}, kReg);
+    }
+    if (canShuffle)
+      numMixed = getWarpLayoutConvertDecomposition(srcLayout, dstLayout, 32)
+                     .mixedTranspositions.size();
+    bool shuffle = (forceWarpShuffle && canShuffle) ||
+                   (!pricedFree && canShuffle && numMixed < 2);
+    if (shuffle) {
+      cls = "warp_shuffle";
+    } else {
+      cls = "shared_memory";
+      if (isCvtDimSync(srcLayout, dstLayout, kWarp))
+        barrier = "warp";
+      else if (isCvtDimSync(srcLayout, dstLayout, kBlock))
+        barrier = "cta";
+      else
+        barrier = "cluster";
+    }
+    // Cross-check against the public helper the allocator uses.
+    if (!forceWarpShuffle) {
+      bool publicSmem = !pricedFree && cvtNeedsSharedMemory(rawSrc, rawDst);
+      classifierMismatch = publicSmem != !shuffle;
+    }
+  }
+
+  llvm::json::Array shape;
+  for (int64_t d : srcTy.getShape())
+    shape.push_back(d);
+  o["class"] = cls;
+  o["barrier"] = barrier;
+  o["shape"] = std::move(shape);
+  o["dtype"] = str(elemTy);
+  o["elems"] = elems;
+  o["bits"] = bits;
+  o["bytes"] = (elems * bits) >> 3;
+  o["priced_bytes"] = pricedBytes;
+  o["priced_free"] = pricedFree;
+  o["assumed_cost"] = pricedFree ? 0 : 32 * pricedBytes;
+  o["can_shuffle"] = canShuffle;
+  o["n_mixed"] = numMixed;
+  o["force_warp_shuffle"] = forceWarpShuffle;
+  o["classifier_mismatch"] = classifierMismatch;
+  o["src"] = str(srcTy.getEncoding());
+  o["dst"] = str(dstEncoding);
+  return o;
+}
+
+void census(ModuleOp module, llvm::StringRef stage) {
+  if (!enabled())
+    return;
+  int index = 0;
+  module.walk([&](gpu::ConvertLayoutOp cvt) {
+    llvm::json::Object o =
+        describeConversion(cast<RankedTensorType>(cvt.getSrc().getType()),
+                           cvt.getType().getEncoding(),
+                           cvt.getForceWarpShuffle());
+    o["event"] = "census";
+    o["stage"] = stage.str();
+    o["index"] = index++;
+    o["func"] = funcName(cvt.getOperation());
+    o["loop_depth"] = loopDepth(cvt.getOperation());
+    Operation *srcOp = cvt.getSrc().getDefiningOp();
+    o["src_op"] = srcOp ? srcOp->getName().getStringRef().str() : "block_arg";
+    llvm::json::Array users;
+    for (Operation *user : cvt.getResult().getUsers())
+      users.push_back(user->getName().getStringRef().str());
+    o["users"] = std::move(users);
+    emit(std::move(o));
+  });
+  llvm::json::Object summary;
+  summary["event"] = "census_summary";
+  summary["stage"] = stage.str();
+  summary["n_convert"] = index;
+  emit(std::move(summary));
+}
+
+} // namespace mlir::triton::layoutlog
