+llvm::json::Object describeConvertOp(ConvertLayoutOp convertOp) {
+  llvm::json::Object o = layoutlog::describeConversion(
+      cast<RankedTensorType>(convertOp.getSrc().getType()),
+      convertOp.getType().getEncoding(), convertOp.getForceWarpShuffle());
+  o["loop_depth"] = layoutlog::loopDepth(convertOp.getOperation());
+  o["func"] = layoutlog::funcName(convertOp.getOperation());
+  // Identity of the op within this pass run, to recognise re-evaluations.
+  o["op_id"] = (int64_t)(uintptr_t)convertOp.getOperation();
+  return o;
+}
+
+void logConflict(Value value, ArrayRef<Attribute> candidates, Attribute chosen,
+                 const char *rule, int index) {
+  llvm::json::Object o;
+  o["event"] = "conflict";
+  o["index"] = index;
+  Operation *op = value.getDefiningOp();
+  Operation *anchor = op;
+  unsigned depth = 0;
+  if (op) {
+    o["op"] = op->getName().getStringRef().str();
+    depth = layoutlog::loopDepth(op);
+  } else {
+    anchor = cast<BlockArgument>(value).getOwner()->getParentOp();
+    o["op"] = "block_arg";
+    o["block_parent"] = anchor ? anchor->getName().getStringRef().str() : "";
+    depth = layoutlog::loopDepth(anchor) +
+            (anchor && isa<scf::ForOp, scf::WhileOp>(anchor) ? 1 : 0);
+  }
+  o["func"] = layoutlog::funcName(anchor);
+  o["loop_depth"] = depth;
+  auto type = cast<RankedTensorType>(value.getType());
+  llvm::json::Array shape;
+  for (int64_t d : type.getShape())
+    shape.push_back(d);
+  o["shape"] = std::move(shape);
+  o["dtype"] = layoutlog::str(type.getElementType());
+  o["current"] = layoutlog::str(type.getEncoding());
+  llvm::json::Array cands;
+  int chosenIndex = -1;
+  for (auto [i, e] : llvm::enumerate(candidates)) {
+    cands.push_back(layoutlog::str(e));
+    if (e == chosen)
+      chosenIndex = i;
+  }
+  o["candidates"] = std::move(cands);
+  o["chosen"] = chosenIndex;
+  o["rule"] = rule;
+  llvm::json::Array users;
+  for (Operation *user : value.getUsers())
+    users.push_back(user->getName().getStringRef().str());
+  o["users"] = std::move(users);
+  layoutlog::emit(std::move(o));
+}
+
+void logRematSkip(ConvertLayoutOp convertOp, const char *reason) {
+  if (!layoutlog::enabled())
+    return;
+  llvm::json::Object o;
+  o["event"] = "remat_skip";
+  o["reason"] = reason;
+  o["subject"] = describeConvertOp(convertOp);
+  layoutlog::emit(std::move(o));
+}
+
+void logRematDecision(ConvertLayoutOp convertOp, size_t sliceValues,
