+// --- Experiment overrides. Each is inert unless its variable is set. ---------
+
+// TRITON_LAYOUT_RESOLVE_OVERRIDE="1:0=2,3:1=0": at pass invocation 1 the
+// conflict with index 0 takes candidate 2; at invocation 3, conflict 1 takes
+// candidate 0. Returns -1 when there is no entry.
+int resolveOverride(int invocation, int conflictIndex);
+
+// TRITON_LAYOUT_DISABLE_WARP_SHUFFLE=1: conversions that would lower to warp
+// shuffles go through shared memory instead, unless force_warp_shuffle is set.
+bool warpShuffleDisabled();
+
+// TRITON_LAYOUT_REPRICE="warp_shuffle=0:4,shared_memory:cta=20000:8": replace
+// getConvertCost for that class (optionally class:barrier) with
+// fixed + perByte * pricedBytes. Returns false when there is no entry.
+bool reprice(llvm::StringRef cls, llvm::StringRef barrier, int64_t pricedBytes,
+             int64_t &cost);
+
 } // namespace mlir::triton::layoutlog
 
 #endif // TRITON_ANALYSIS_LAYOUTLOG_H
