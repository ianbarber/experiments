     if (shuffle) {
       cls = "warp_shuffle";
     } else {
@@ -233,4 +234,68 @@ void census(ModuleOp module, llvm::StringRef stage) {
   emit(std::move(summary));
 }
 
+// --- overrides ---------------------------------------------------------------
+
+namespace {
+// Split "a=b,c=d" into pairs.
+SmallVector<std::pair<StringRef, StringRef>> parsePairs(StringRef text) {
+  SmallVector<std::pair<StringRef, StringRef>> pairs;
+  SmallVector<StringRef> items;
+  text.split(items, ',', /*MaxSplit=*/-1, /*KeepEmpty=*/false);
+  for (StringRef item : items) {
+    auto [key, value] = item.split('=');
+    pairs.emplace_back(key.trim(), value.trim());
+  }
+  return pairs;
+}
+} // namespace
+
+int resolveOverride(int invocation, int conflictIndex) {
+  const char *env = std::getenv("TRITON_LAYOUT_RESOLVE_OVERRIDE");
+  if (!env || !*env)
+    return -1;
+  for (auto [key, value] : parsePairs(env)) {
+    auto [invStr, idxStr] = key.split(':');
+    int inv = 0, idx = 0, candidate = 0;
+    if (invStr.getAsInteger(10, inv) || idxStr.getAsInteger(10, idx) ||
+        value.getAsInteger(10, candidate))
+      continue;
+    if (inv == invocation && idx == conflictIndex)
+      return candidate;
+  }
+  return -1;
+}
+
+bool warpShuffleDisabled() {
+  const char *env = std::getenv("TRITON_LAYOUT_DISABLE_WARP_SHUFFLE");
+  return env && StringRef(env) == "1";
+}
+
+bool reprice(StringRef cls, StringRef barrier, int64_t pricedBytes,
+             int64_t &cost) {
+  const char *env = std::getenv("TRITON_LAYOUT_REPRICE");
+  if (!env || !*env)
+    return false;
+  std::string specific = (cls + ":" + barrier).str();
+  StringRef found;
+  bool haveSpecific = false, haveGeneric = false;
+  for (auto [key, value] : parsePairs(env)) {
+    if (key == specific) {
+      found = value;
+      haveSpecific = true;
+    } else if (key == cls && !haveSpecific) {
+      found = value;
+      haveGeneric = true;
+    }
+  }
+  if (!haveSpecific && !haveGeneric)
+    return false;
+  auto [fixedStr, perByteStr] = found.split(':');
+  double fixed = 0, perByte = 0;
+  if (fixedStr.getAsDouble(fixed) || perByteStr.getAsDouble(perByte))
+    return false;
+  cost = (int64_t)(fixed + perByte * (double)pricedBytes + 0.5);
+  return true;
+}
+
 } // namespace mlir::triton::layoutlog
